<h1 class="text-2xl font-bold mb-4">Sign up</h1>

<%= form_with model: @user, url: registration_path do |form| %>
  <% if @user.errors.any? %>
    <div class="text-red-600 mb-4">
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :email_address %><br>
    <%= form.email_field :email_address, class: "border rounded px-2 py-1 w-full" %>
  </div>

  <div class="mb-3">
    <%= form.label :password %><br>
    <%= form.password_field :password, class: "border rounded px-2 py-1 w-full" %>
  </div>

  <%= form.submit "Sign up", class: "bg-blue-600 text-white px-4 py-2 rounded" %>
<% end %>

<p class="mt-4"><%= link_to "Already have an account? Log in", new_session_path %></p>