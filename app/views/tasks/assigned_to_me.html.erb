<h1 class="text-2xl font-bold text-gray-900 mb-6">Assigned to me</h1>

<% if @tasks.any? %>
  <ul class="space-y-2">
    <% @tasks.each do |task| %>
      <li class="bg-white border border-gray-200 rounded-lg px-4 py-3">
        <p class="font-medium text-gray-900"><%= task.title %></p>
        <p class="text-sm text-gray-500">in <%= task.project.name %> · <%= task.status %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-gray-500">No tasks assigned to you.</p>
<% end %>