<%= link_to "← Back to project", project_path(@project), class: "text-sm text-gray-500 hover:text-gray-700" %>

<div class="mt-4 bg-white border border-gray-200 rounded-lg p-5">
  <div class="flex justify-between items-start">
    <div>
      <h1 class="text-xl font-bold text-gray-900"><%= @task.title %></h1>
<p class="text-sm text-gray-500 mt-1">in<% if @project.user == Current.user %><%= link_to @project.name, project_path(@project), class: "underline" %>
  <% else %><%= @project.name %><% end %></p> </div>

    <% if @project.user == Current.user %>
      <%= link_to "Edit", edit_project_task_path(@project, @task), class: "text-sm text-blue-600 underline" %>
    <% end %>
  </div>

  <p class="text-gray-700 mt-4"><%= @task.description %></p>

  <div class="mt-4">
    <%= form_with url: update_status_project_task_path(@project, @task), method: :patch do |form| %>
      <%= form.select :status, Task.statuses.keys, { selected: @task.status },
            class: status_badge_class(@task.status) + " text-sm border-0 rounded-full px-3 py-1 font-medium cursor-pointer",
            onchange: "this.form.requestSubmit()" %>
    <% end %>
  </div>
</div>