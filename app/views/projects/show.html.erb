<h1 class="text-2xl font-bold mb-2"><%= @project.name %></h1>
<p class="mb-4"><%= @project.description %></p>

<%= link_to "Edit Project", edit_project_path(@project), class: "text-blue-600 underline mr-4" %>
<%= button_to "Delete Project", project_path(@project), method: :delete, class: "text-red-600 underline", form: { data: { turbo_confirm: "Are you sure?" } } %>

<h2 class="text-xl font-bold mt-6 mb-2">Tasks</h2>
<%= link_to "New Task", new_project_task_path(@project), class: "bg-blue-600 text-white px-3 py-1 rounded inline-block mb-4" %>

<ul id="tasks">
  <%= render @project.tasks, project: @project %>
</ul>

<%= link_to "← Back to projects", projects_path, class: "block mt-4 text-gray-600" %>