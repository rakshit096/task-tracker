<div class="mb-6">
  <%= link_to "← Back to projects", projects_path, class: "text-sm text-gray-500 hover:text-gray-700" %>

  <div class="flex justify-between items-start mt-2">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @project.name %></h1>
      <p class="text-gray-600 mt-1"><%= @project.description %></p>
    </div>
    <div class="flex gap-3">
      <%= link_to "Edit", edit_project_path(@project), class: "text-sm text-gray-600 hover:text-gray-900 underline" %>
      <%= button_to "Delete", project_path(@project), method: :delete, class: "text-sm text-red-600 hover:text-red-700 underline bg-transparent border-0 cursor-pointer", form: { data: { turbo_confirm: "Are you sure?" } } %>
    </div>
  </div>
</div>

<div class="flex justify-between items-center mb-3">
  <h2 class="text-lg font-semibold text-gray-900">Tasks</h2>
  <%= link_to "New Task", new_project_task_path(@project), class: "bg-blue-600 hover:bg-blue-500 text-white px-3 py-1.5 rounded-md text-sm font-medium" %>
</div>

<div class="mb-6">
  <h2 class="text-lg font-semibold text-gray-900 mb-2">
    Unassigned <span class="text-sm font-normal text-gray-400">(<%= @unassigned_tasks.size %>)</span>
  </h2>
  <% if @unassigned_tasks.any? %>
    <ul id="unassigned_tasks" class="space-y-2">
      <%= render @unassigned_tasks, project: @project %>
    </ul>
  <% else %>
    <p class="text-sm text-gray-400">Nothing unassigned.</p>
  <% end %>
</div>

<div>
  <h2 class="text-lg font-semibold text-gray-900 mb-2">
    Assigned <span class="text-sm font-normal text-gray-400">(<%= @assigned_tasks.size %>)</span>
  </h2>
  <% if @assigned_tasks.any? %>
    <ul id="assigned_tasks" class="space-y-2">
      <%= render @assigned_tasks, project: @project %>
    </ul>
  <% else %>
    <p class="text-sm text-gray-400">Nothing assigned yet.</p>
  <% end %>
</div>

<% if @project.tasks.none? %>
  <p class="text-gray-500 text-sm">No tasks yet.</p>
<% end %>