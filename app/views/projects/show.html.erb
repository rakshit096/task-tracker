<h1 class="text-2xl font-bold mb-2"><%= @project.name %></h1>
<p class="mb-4"><%= @project.description %></p>

<%= link_to "Edit", edit_project_path(@project), class: "text-blue-600 underline mr-4" %>
<%= button_to "Delete", project_path(@project), method: :delete, class: "text-red-600 underline", form: { data: { turbo_confirm: "Are you sure?" } } %>

<%= link_to "← Back to projects", projects_path, class: "block mt-4 text-gray-600" %>   