<%= form_with model: @project do |form| %>
  <% if @project.errors.any? %>
    <div class="text-red-600 mb-4 text-sm">
      <ul>
        <% @project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :name, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-blue-600 px-3 py-2 w-full" %>
  </div>

  <div class="mb-6">
    <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_area :description, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-blue-600 px-3 py-2 w-full" %>
  </div>

  <%= form.submit class: "bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-md font-medium cursor-pointer" %>
<% end %>